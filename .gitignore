# Git 忽略文件
# 自动生成的文件和临时文件

# 构建目录
build/
bin/
*.exe
*.out
*.o
*.obj

# IDE 配置
.vscode/
.vs/
.idea/
*.suo
*.user
*.sln.docstates

# CMake 生成文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# 结果文件(可选,根据需要保留或忽略)
results/*.txt
results/*.png

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
*.swp
*~
